<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- True black everywhere: the LP3 panel renders black as "off". -->
    <style name="Theme.WaPoc" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- The system splash is plain black, so it flows into the app's own splash. -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
